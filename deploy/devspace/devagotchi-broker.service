# systemd --user unit for the Devagotchi broker in a devspace tenant.
# Installed by provision.sh to ~/.config/systemd/user/. Starts once the broker
# has been built (see README: Build and start the broker).
[Unit]
Description=Devagotchi broker (per-user, independently supervised jobs)
Documentation=https://github.com/EonsofStupid/devagotchi
ConditionPathExists=/devspace/bin/devagotchi
After=default.target

[Service]
Type=simple
ExecStart=/devspace/bin/devagotchi broker run --state-dir /devspace/state/devagotchi --config /devspace/config/devagotchi/broker.json
WorkingDirectory=/devspace
# Restart=always, not on-failure: on-failure skips SIGTERM and clean exits.
Restart=always
RestartSec=1
# The broker's own cgroup subtree is delegated so each job can live in a child cgroup
# (the "subtree" rung); the default "scope" rung uses the user bus instead.
Delegate=yes
# Jobs are the broker's to settle; systemd kills the control group only if the broker fails to.
KillMode=mixed
TimeoutStopSec=30
NoNewPrivileges=no

[Install]
WantedBy=default.target
