# The name people and AI clients reach the hub at. Caddy gets its certificate for it.
# `localhost` works for a try-out (Caddy's own certificate, which browsers warn about).
DEVAGOTCHI_DOMAIN=hub.example.com

# Everything below has a default; set only what differs.
# DEVAGOTCHI_IMAGE=ghcr.io/eonsofstupid/devagotchi:main
# DEVAGOTCHI_HTTP_PORT=80
# DEVAGOTCHI_HTTPS_PORT=443
# The URL clients use, when it is not https://DEVAGOTCHI_DOMAIN (another port, a proxy in front):
# DEVAGOTCHI_PUBLIC_URL=https://hub.example.com:8443
# The passkeys' relying party: the domain (the default) or a parent of it, so passkeys work
# on its sibling hosts. It can never change for passkeys already made.
# DEVAGOTCHI_RP_ID=example.com
# Where the hub's plain HTTP port is published, for an edge proxy that is not this stack's
# Caddy (start only `postgres hub` then). Loopback by default.
# DEVAGOTCHI_HUB_BIND=127.0.0.1
# DEVAGOTCHI_HUB_PORT=8787
# Postgres sizing for the box it runs on (defaults suit 2 GB of RAM):
# DEVAGOTCHI_PG_SHARED_BUFFERS=256MB
# DEVAGOTCHI_PG_EFFECTIVE_CACHE_SIZE=768MB
# DEVAGOTCHI_PG_MAX_CONNECTIONS=50
# DEVAGOTCHI_PG_SLOW_MS=500
