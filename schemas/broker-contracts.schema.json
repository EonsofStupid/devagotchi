{
  "$defs": {
    "BridgeError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ChangesInput": {
      "additionalProperties": false,
      "description": "Wait until the broker's operations change as a list shows them: one admitted, retired,\nor moved to another state (output alone is not a change here). For a view that\nre-lists only when something changed, instead of on a timer.",
      "properties": {
        "after_revision": {
          "description": "The revision your list reflects (from the last answer). Absent: answer at once with\nthe current revision. A broker that restarted answers at once, too.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "timeout_ms": {
          "description": "Longest to wait, 1..=50000 milliseconds; at the limit the same revision comes back.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "timeout_ms"
      ],
      "type": "object"
    },
    "DirectoryInput": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Absolute path of the directory to make; missing parents are made too. An existing\ndirectory is not an error.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "FileContent": {
      "additionalProperties": false,
      "properties": {
        "bytes_base64": {
          "description": "The raw bytes, base64, when they are not text.",
          "type": [
            "string",
            "null"
          ]
        },
        "eof": {
          "description": "Whether this page reached the end of the file.",
          "type": "boolean"
        },
        "modified_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "next_line": {
          "description": "Read by lines: the `start_line` to read on from, when lines remain and the number\nis known. A single line longer than `max_bytes` is read on by bytes, from\n`next_offset`.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "next_offset": {
          "description": "The offset to read on from.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "offset": {
          "description": "Where these bytes start.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "The file's canonical path.",
          "type": "string"
        },
        "size": {
          "description": "The file's size in bytes when it was read.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "start_line": {
          "description": "Read by lines: the 1-based number of the first line returned, when known (always\nfor a positive `start_line`; from the end, for files up to 8 MiB).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "text": {
          "description": "The bytes as text, when they are UTF-8 text. A character split at the end of the\npage is left for the next read.",
          "type": [
            "string",
            "null"
          ]
        },
        "total_lines": {
          "description": "Read by lines: the file's line count, for files up to 8 MiB or once the end is read.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "size",
        "offset",
        "next_offset",
        "eof"
      ],
      "type": "object"
    },
    "FileEditInput": {
      "additionalProperties": false,
      "properties": {
        "expected_replacements": {
          "default": 1,
          "description": "How many times `old_text` must occur (default 1); every occurrence is replaced, and\na different count changes nothing.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "new_text": {
          "description": "Text to put in its place.",
          "type": "string"
        },
        "old_text": {
          "description": "Exact text to find, including whitespace and line endings.",
          "type": "string"
        },
        "path": {
          "description": "Absolute path of a UTF-8 text file.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "old_text",
        "new_text"
      ],
      "type": "object"
    },
    "FileEntry": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "description": "Why a directory's own entries are missing (it could not be read).",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "`file`, `dir`, `symlink` or `other`. Symbolic links are listed, never followed.",
          "type": "string"
        },
        "modified_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "description": "Path relative to the listed directory, `/`-separated.",
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "type": "object"
    },
    "FileInfo": {
      "additionalProperties": false,
      "properties": {
        "created_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "description": "`file`, `dir`, `symlink` or `other`.",
          "type": "string"
        },
        "lines": {
          "description": "For a text file of at most 8 MiB: how many lines it has.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "link_target": {
          "description": "Where a symbolic link points, as stored in the link.",
          "type": [
            "string",
            "null"
          ]
        },
        "made": {
          "description": "After create_directory: whether this call made it (false: it existed already).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "mode": {
          "description": "Unix permission bits in octal (`0644`); absent on Windows.",
          "type": [
            "string",
            "null"
          ]
        },
        "modified_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "description": "The path, canonical up to its own name (a link is reported as itself).",
          "type": "string"
        },
        "readonly": {
          "description": "Whether its permissions mark it read-only.",
          "type": "boolean"
        },
        "replaced": {
          "description": "After move_file: whether a file at the destination was replaced.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "size": {
          "description": "Size in bytes (for a link, the link's own).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "kind",
        "size",
        "readonly"
      ],
      "type": "object"
    },
    "FileInfoInput": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Absolute path of a file, directory or symbolic link.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "FileListInput": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "default": 0,
          "description": "How many levels below it to include, 0..=3 (default 0: its own entries).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_entries": {
          "default": 200,
          "description": "Most entries to return, 1..=1000 (default 200).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "Absolute path of the directory.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "FileListing": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "description": "Directories first at each level, then by name.",
          "items": {
            "$ref": "#/$defs/FileEntry"
          },
          "type": "array"
        },
        "path": {
          "description": "The directory's canonical path.",
          "type": "string"
        },
        "truncated": {
          "description": "Whether `max_entries` cut the listing short.",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "entries",
        "truncated"
      ],
      "type": "object"
    },
    "FileMoveInput": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "description": "Absolute path it moves to, on the same filesystem. Its parent directory must exist.",
          "type": "string"
        },
        "overwrite": {
          "default": false,
          "description": "Replace a file already at the destination (never a directory). Default false: an\nexisting destination refuses the move and changes nothing.",
          "type": "boolean"
        },
        "source": {
          "description": "Absolute path of the file, directory or link to move or rename (a link moves as\nitself, never what it points to).",
          "type": "string"
        }
      },
      "required": [
        "source",
        "destination"
      ],
      "type": "object"
    },
    "FileReadInput": {
      "additionalProperties": false,
      "properties": {
        "line_count": {
          "description": "With `start_line`: how many lines, 1..=5000 (default 1000; from a negative\n`start_line`, the lines to the end). Never more than `max_bytes` of text.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_bytes": {
          "default": 24576,
          "description": "Bytes to read, 1..=24576 (default 24576). Read on from `next_offset` for more.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Byte offset to start at; negative counts back from the end (a tail). Default 0.",
          "format": "int64",
          "type": "integer"
        },
        "path": {
          "description": "Absolute path of the file.",
          "type": "string"
        },
        "start_line": {
          "description": "Read by lines instead of bytes: the 1-based line to start at, or negative to count\nback from the end (-50: the last 50 lines). `offset` is then not used.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "FileWriteInput": {
      "additionalProperties": false,
      "properties": {
        "bytes_base64": {
          "description": "The content as base64 bytes. At most 32 KiB of content per call; append for more.",
          "type": [
            "string",
            "null"
          ]
        },
        "create_dirs": {
          "default": false,
          "description": "Create missing parent directories.",
          "type": "boolean"
        },
        "expected_sha256": {
          "description": "Overwrite only if the file's current SHA-256 is this (from an earlier write or\nedit), so a change made in between is not lost.",
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "$ref": "#/$defs/WriteMode",
          "default": "overwrite"
        },
        "path": {
          "description": "Absolute path of the file.",
          "type": "string"
        },
        "text": {
          "description": "The content as text, written as UTF-8 exactly as given. Give this or `bytes_base64`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "FileWritten": {
      "additionalProperties": false,
      "properties": {
        "created": {
          "description": "Whether the file was created.",
          "type": "boolean"
        },
        "path": {
          "description": "The file's canonical path.",
          "type": "string"
        },
        "replacements": {
          "description": "For an edit: how many occurrences were replaced.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "sha256": {
          "description": "SHA-256 of its whole content after the change: pass it as `expected_sha256` next time.",
          "type": "string"
        },
        "size": {
          "description": "Its size after the change.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size",
        "sha256",
        "created"
      ],
      "type": "object"
    },
    "GetInput": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "type": "string"
        }
      },
      "required": [
        "operation_id"
      ],
      "type": "object"
    },
    "ListInput": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 32,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "OperationState": {
      "enum": [
        "accepted",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out",
        "interrupted",
        "unknown"
      ],
      "type": "string"
    },
    "OperationSummary": {
      "additionalProperties": false,
      "properties": {
        "created_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "display_command": {
          "description": "Bounded display preview only. Execute only the exact argv from the canonical request.",
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/OperationState"
        },
        "updated_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "operation_id",
        "state",
        "created_at_ms",
        "updated_at_ms",
        "display_command"
      ],
      "type": "object"
    },
    "OperationView": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cancellation_requested": {
          "type": "boolean"
        },
        "created_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "cwd": {
          "type": "string"
        },
        "deadline_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "executable": {
          "type": "string"
        },
        "exit_code": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "operation_id": {
          "type": "string"
        },
        "output_complete": {
          "type": "boolean"
        },
        "ownership_scope": {
          "description": "Root process and its inherited process group only; this is not OS containment.",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/OperationState"
        },
        "updated_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "operation_id",
        "executable",
        "args",
        "cwd",
        "deadline_ms",
        "state",
        "created_at_ms",
        "updated_at_ms",
        "ownership_scope",
        "cancellation_requested",
        "output_complete"
      ],
      "type": "object"
    },
    "OperationsPage": {
      "additionalProperties": false,
      "properties": {
        "next_offset": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/OperationSummary"
          },
          "type": "array"
        }
      },
      "required": [
        "operations"
      ],
      "type": "object"
    },
    "OutputFrame": {
      "additionalProperties": false,
      "properties": {
        "bytes_base64": {
          "description": "Raw process bytes, losslessly encoded. Text below is a UTF-8 convenience view.",
          "type": "string"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stream": {
          "type": "string"
        },
        "text": {
          "description": "Incrementally decoded per stream; split UTF-8 sequences are retained between chunks.",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "stream",
        "bytes_base64",
        "text"
      ],
      "type": "object"
    },
    "OutputPage": {
      "additionalProperties": false,
      "properties": {
        "earliest_retained_sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/OutputFrame"
          },
          "type": "array"
        },
        "gap": {
          "description": "True when requested output was evicted from this operation's bounded retention.",
          "type": "boolean"
        },
        "has_more": {
          "type": "boolean"
        },
        "latest_sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "next_cursor": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "operation": {
          "$ref": "#/$defs/OperationView"
        },
        "operation_id": {
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "frames",
        "next_cursor",
        "gap",
        "earliest_retained_sequence",
        "latest_sequence",
        "has_more",
        "operation"
      ],
      "type": "object"
    },
    "ReadInput": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "default": 0,
          "description": "Last sequence consumed, starting at zero. Reading never advances another reader.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_bytes": {
          "default": 16384,
          "description": "Maximum raw bytes to return, 1024..=16384. Frames are at most 1024 bytes.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "operation_id": {
          "type": "string"
        }
      },
      "required": [
        "operation_id"
      ],
      "type": "object"
    },
    "Revision": {
      "additionalProperties": false,
      "description": "The broker's current operations revision.",
      "properties": {
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "revision"
      ],
      "type": "object"
    },
    "StartInput": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "default": [],
          "description": "Exact argument vector. No shell parsing, interpolation, or added command text.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "description": "A command line for the machine's own shell (bash or sh on Linux, Windows PowerShell\non Windows), accepted by a broker that runs commands as its account. Give either\nthis or `executable` with `args`, not both.",
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "description": "Absolute working directory; defaults to the workspace. A broker that runs only\ngranted programs keeps it within the workspace.",
          "type": [
            "string",
            "null"
          ]
        },
        "deadline_ms": {
          "description": "Execution deadline, not a client wait timeout. 1..=300000 milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "executable": {
          "default": "",
          "description": "Absolute path of the program to run, with `args`. On a broker that runs only\noperator-granted programs it must be granted. Leave empty when `command` is given.",
          "type": "string"
        },
        "idempotency_key": {
          "description": "A caller-created retry key. The same key and inputs return the same operation.",
          "type": "string"
        }
      },
      "required": [
        "idempotency_key",
        "deadline_ms"
      ],
      "type": "object"
    },
    "StartOutput": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "$ref": "#/$defs/OperationView"
        },
        "replayed": {
          "type": "boolean"
        }
      },
      "required": [
        "operation",
        "replayed"
      ],
      "type": "object"
    },
    "WaitInput": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "type": "string"
        },
        "output_after": {
          "description": "Return when output beyond this sequence exists (the cursor you have read up to), as\nwell as when the operation settles. Without it, return only when it settles.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "timeout_ms": {
          "description": "Longest to wait, 1..=50000 milliseconds. The answer comes as soon as the operation\nchanges as asked, without polling; at the limit it comes back unchanged.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "operation_id",
        "timeout_ms"
      ],
      "type": "object"
    },
    "WriteMode": {
      "oneOf": [
        {
          "const": "overwrite",
          "description": "Replace the file's whole content (atomically: a new file renamed into place), or\ncreate it. The default.",
          "type": "string"
        },
        {
          "const": "create",
          "description": "Create the file; refuse when it exists.",
          "type": "string"
        },
        {
          "const": "append",
          "description": "Add to the end of the file, creating it when missing.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Export-only schema root. These fields reference canonical Rust DTOs and are\nnot a broker request or a second set of independently authored contracts.",
  "properties": {
    "bridge_error": {
      "$ref": "#/$defs/BridgeError"
    },
    "changes_input": {
      "$ref": "#/$defs/ChangesInput"
    },
    "directory_input": {
      "$ref": "#/$defs/DirectoryInput"
    },
    "file_content": {
      "$ref": "#/$defs/FileContent"
    },
    "file_edit_input": {
      "$ref": "#/$defs/FileEditInput"
    },
    "file_info": {
      "$ref": "#/$defs/FileInfo"
    },
    "file_info_input": {
      "$ref": "#/$defs/FileInfoInput"
    },
    "file_list_input": {
      "$ref": "#/$defs/FileListInput"
    },
    "file_listing": {
      "$ref": "#/$defs/FileListing"
    },
    "file_move_input": {
      "$ref": "#/$defs/FileMoveInput"
    },
    "file_read_input": {
      "$ref": "#/$defs/FileReadInput"
