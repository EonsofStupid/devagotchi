{
  "$defs": {
    "BridgeError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "FileEntry": {
      "additionalProperties": false,
      "description": "One directory entry, describing the entry itself and never a link target.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/FileKind"
        },
        "modified_ms": {
          "description": "Last modification time in Unix milliseconds, when the filesystem reports one.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "description": "The entry's name. When `name_exact` is false the native name is not valid Unicode; invalid\nsequences are shown as U+FFFD and this version cannot address the entry by path.",
          "type": "string"
        },
        "name_exact": {
          "type": "boolean"
        },
        "size_bytes": {
          "description": "Present for regular files.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "name_exact",
        "kind"
      ],
      "type": "object"
    },
    "FileKind": {
      "description": "The kind of a directory entry itself. `symlink` covers symbolic links, junctions, and other\nname-surrogate reparse points; they are never followed.",
      "enum": [
        "file",
        "directory",
        "symlink",
        "other"
      ],
      "type": "string"
    },
    "FileListInput": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "default": null,
          "description": "The previous page's `next_cursor`; omit it for the first page.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "default": 128,
          "description": "Maximum entries to return, 1..=512.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "Absolute path of a directory within the configured workspace.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "FileListPage": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "description": "Entries in ascending native-name order after the request cursor.",
          "items": {
            "$ref": "#/$defs/FileEntry"
          },
          "type": "array"
        },
        "next_cursor": {
          "description": "Pass as `cursor` to read the next page; absent on the last page.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Canonical absolute path of the listed directory.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "entries"
      ],
      "type": "object"
    },
    "FileReadInput": {
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "default": 65536,
          "description": "Maximum bytes to return, 1024..=65536.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Byte offset of the first byte to return.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "Absolute path of a regular file within the configured workspace.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "FileReadPage": {
      "additionalProperties": false,
      "properties": {
        "bytes_base64": {
          "description": "The exact bytes read.",
          "type": "string"
        },
        "eof": {
          "description": "True when the read reached the end of the file.",
          "type": "boolean"
        },
        "next_offset": {
          "description": "Offset to request next.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "offset": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "Canonical absolute path of the file that was read.",
          "type": "string"
        },
        "revision": {
          "$ref": "#/$defs/FileRevision"
        },
        "text": {
          "description": "The same bytes as text when they are valid UTF-8. A character split by the page end is\nleft for the next page; any other invalid sequence leaves this absent.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "revision",
        "offset",
        "bytes_base64",
        "next_offset",
        "eof"
      ],
      "type": "object"
    },
    "FileRevision": {
      "additionalProperties": false,
      "description": "The version of a file a read observed.",
      "properties": {
        "identity": {
          "description": "Identity of the file object: device and inode on Unix, volume serial and file ID on\nWindows. It survives a rename and changes when the file is replaced by another object.",
          "type": "string"
        },
        "modified_ms": {
          "description": "Last modification time in Unix milliseconds, when the filesystem reports one.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "identity",
        "size_bytes"
      ],
      "type": "object"
    },
    "GetInput": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "type": "string"
        }
      },
      "required": [
        "operation_id"
      ],
      "type": "object"
    },
    "ListInput": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 32,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "OperationState": {
      "enum": [
        "accepted",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out",
        "interrupted",
        "unknown"
      ],
      "type": "string"
    },
    "OperationSummary": {
      "additionalProperties": false,
      "properties": {
        "created_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "display_command": {
          "description": "Bounded display preview only. Execute only the exact argv from the canonical request.",
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/OperationState"
        },
        "updated_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "operation_id",
        "state",
        "created_at_ms",
        "updated_at_ms",
        "display_command"
      ],
      "type": "object"
    },
    "OperationView": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cancellation_requested": {
          "type": "boolean"
        },
        "created_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "cwd": {
          "type": "string"
        },
        "deadline_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "executable": {
          "type": "string"
        },
        "exit_code": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "operation_id": {
          "type": "string"
        },
        "output_complete": {
          "type": "boolean"
        },
        "ownership_scope": {
          "description": "Root process and its inherited process group only; this is not OS containment.",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/OperationState"
        },
        "updated_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "operation_id",
        "executable",
        "args",
        "cwd",
        "deadline_ms",
        "state",
        "created_at_ms",
        "updated_at_ms",
        "ownership_scope",
        "cancellation_requested",
        "output_complete"
      ],
      "type": "object"
    },
    "OperationsPage": {
      "additionalProperties": false,
      "properties": {
        "next_offset": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/OperationSummary"
          },
          "type": "array"
        }
      },
      "required": [
        "operations"
      ],
      "type": "object"
    },
    "OutputFrame": {
      "additionalProperties": false,
      "properties": {
        "bytes_base64": {
          "description": "Raw process bytes, losslessly encoded. Text below is a UTF-8 convenience view.",
          "type": "string"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stream": {
          "type": "string"
        },
        "text": {
          "description": "Incrementally decoded per stream; split UTF-8 sequences are retained between chunks.",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "stream",
        "bytes_base64",
        "text"
      ],
      "type": "object"
    },
    "OutputPage": {
      "additionalProperties": false,
      "properties": {
        "earliest_retained_sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/OutputFrame"
          },
          "type": "array"
        },
        "gap": {
          "description": "True when requested output was evicted from this operation's bounded retention.",
          "type": "boolean"
        },
        "has_more": {
          "type": "boolean"
        },
        "latest_sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "next_cursor": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "operation": {
          "$ref": "#/$defs/OperationView"
        },
        "operation_id": {
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "frames",
        "next_cursor",
        "gap",
        "earliest_retained_sequence",
        "latest_sequence",
        "has_more",
        "operation"
      ],
      "type": "object"
    },
    "ReadInput": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "default": 0,
          "description": "Last sequence consumed, starting at zero. Reading never advances another reader.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_bytes": {
          "default": 16384,
          "description": "Maximum raw bytes to return, 1024..=16384. Frames are at most 1024 bytes.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "operation_id": {
          "type": "string"
        }
      },
      "required": [
        "operation_id"
      ],
      "type": "object"
    },
    "StartInput": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "default": [],
          "description": "Exact argument vector. No shell parsing, interpolation, or added command text.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cwd": {
          "description": "Absolute working directory within the configured workspace; defaults to its root.",
          "type": [
            "string",
            "null"
          ]
        },
        "deadline_ms": {
          "description": "Execution deadline, not a client wait timeout. 1..=300000 milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "executable": {
          "description": "Absolute path of an executable granted by the broker operator.",
          "type": "string"
        },
        "idempotency_key": {
          "description": "A caller-created retry key. The same key and inputs return the same operation.",
          "type": "string"
        }
      },
      "required": [
        "idempotency_key",
        "executable",
        "deadline_ms"
      ],
      "type": "object"
    },
    "StartOutput": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "$ref": "#/$defs/OperationView"
        },
        "replayed": {
          "type": "boolean"
        }
      },
      "required": [
        "operation",
        "replayed"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Export-only schema root. These fields reference canonical Rust DTOs and are\nnot a broker request or a second set of independently authored contracts.",
  "properties": {
    "bridge_error": {
      "$ref": "#/$defs/BridgeError"
    },
    "file_list_input": {
      "$ref": "#/$defs/FileListInput"
    },
    "file_list_page": {
      "$ref": "#/$defs/FileListPage"
    },
    "file_read_input": {
      "$ref": "#/$defs/FileReadInput"
    },
    "file_read_page": {
      "$ref": "#/$defs/FileReadPage"
    },
    "get_input": {
      "$ref": "#/$defs/GetInput"
    },
    "list_input": {
      "$ref": "#/$defs/ListInput"
    },
    "operation_view": {
      "$ref": "#/$defs/OperationView"
    },
    "operations_page": {
      "$ref": "#/$defs/OperationsPage"
    },
    "output_page": {
      "$ref": "#/$defs/OutputPage"
    },
    "read_input": {
      "$ref": "#/$defs/ReadInput"
    },
    "start_input": {
      "$ref": "#/$defs/StartInput"
    },
    "start_output": {
      "$ref": "#/$defs/StartOutput"
    }
  },
  "required": [
    "start_input",
    "get_input",
    "read_input",
    "list_input",
    "start_output",
    "operation_view",
    "output_page",
    "operations_page",
    "file_list_input",
    "file_list_page",
    "file_read_input",
    "file_read_page",
    "bridge_error"
  ],
  "title": "BrokerContracts",
  "type": "object"
}
